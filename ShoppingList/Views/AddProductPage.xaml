<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShoppingList.Views.AddProductPage"
             Title="Add Product">

    <StackLayout>
        <Entry x:Name="NameEntry" Placeholder="Product Name" />
        <Entry x:Name="UnitEntry" Placeholder="Unit (pcs, kg, etc.)" />
        <Entry x:Name="QuantityEntry" Placeholder="Quantity" Keyboard="Numeric" />
        <Button Text="Add" Clicked="OnAddButtonClicked" />
    </StackLayout>
</ContentPage>